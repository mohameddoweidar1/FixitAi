# ── Server ────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────
# Use "*" for open access during development, or set a specific origin
CORS_ORIGIN=*

# ── Database ──────────────────────────────────────────────
# Option A (preferred): single connection string
DATABASE_URL=

# Option B (fallback): individual variables (used only if DATABASE_URL is empty)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=fixitai

# ── Auth ──────────────────────────────────────────────────
# JWT signing secret — MUST be a long random string in production (>=16 chars)
JWT_SECRET=change-me-please-use-a-long-random-string
# Token lifetime — accepts zeit/ms-style values (e.g. "15m", "1h", "7d")
JWT_EXPIRES_IN=7d
# bcrypt cost factor (higher = slower + safer; 10 is a typical default)
BCRYPT_SALT_ROUNDS=10

# ── Uploads ───────────────────────────────────────────────
# Storage provider: 'local' (default) | 's3' | 'cloudinary'
STORAGE_PROVIDER=local
# Directory for local uploads (relative to project root)
UPLOAD_DIR=uploads
# Max upload size in MB (per file)
UPLOAD_MAX_SIZE_MB=5
